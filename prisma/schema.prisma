// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Chat {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  // Optional owner to maintain backwards compatibility until auth is enforced
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  role      String   // "user" | "assistant"
  content   String
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  // For tool calls and metadata (stored as JSON strings for SQLite compatibility)
  toolCalls String?  // JSON string
  metadata  String?  // JSON string
  
  @@map("messages")
}

model UserSettings {
  id            String   @id @default(cuid())
  openaiBaseUrl String?  @default("https://api.openai.com/v1")
  openaiApiKey  String?
  modelName     String?  @default("gpt-oss-120b")
  gitlabUrl     String?  @default("https://git.lab/api/v4")
  gitlabToken   String?
  // Optional linkage to a user for per-user settings
  userId        String?  @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("user_settings")
}

// New user model
model User {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  role          UserRole       @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chats         Chat[]
  settings      UserSettings?
  sessions      Session[]
  
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  PENDING
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@map("sessions")
}